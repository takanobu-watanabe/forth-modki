% 階乗の再帰版
% n! = n * (n-1)! を、自分自身を呼ぶことで計算する。
% n が 1 以下になったら 1 を返して止まる。

/fact {
  dup 1 le       % n を複製して「n <= 1 か」を判定   [ n, 判定結果 ]
                 % dup が要るのは、le が2つ消費するため。
                 % 複製しておかないと、この後の枝で n が使えない。
    { pop 1 }    % 真: n を捨てて 1 を返す（1! = 0! = 1）

    {            % 偽: n * (n-1)! を計算する
      dup        %   n を複製            [ n, n ]
      1 sub      %   片方を n-1 に        [ n, n-1 ]
      fact       %   その階乗を求める      [ n, (n-1)! ]  ← 自分自身を呼ぶ
      mul        %   掛ける              [ n! ]
    }
  ifelse
} def

5 fact
