% 階乗のループ版（karino2氏の実装）
% 再帰を使わず、while と index で書く。
% スタックを常に「途中経過、j」の2つに保ち、
% j を途中経過に掛けては j を1減らす、を繰り返す。

/factorial {
  dup
  {dup 1 gt}
  {
    1 sub        % j を1減らす         [ 途中経過, j-1 ]
    exch         % 順番を入れ替える     [ j-1, 途中経過 ]
    1 index      % j-1 をコピー         [ j-1, 途中経過, j-1 ]
    mul          % 掛ける               [ j-1, 新しい途中経過 ]
    exch         % 元の並びに戻す       [ 新しい途中経過, j-1 ]
  } while
  pop            % 残った j を捨てる
} def

5 factorial
