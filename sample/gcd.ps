% 最大公約数（ユークリッドの互除法）のループ版
%
%   gcd(a, b) = b が 0 なら a、そうでなければ gcd(b, a mod b)
%
% a < b のときは a mod b = a になるので、1周余分に回って自然に
% 大きい方が前に来る。事前の大小比較は要らない。
%
% /名前 exch def は「スタックのてっぺんを名前に取り込む」定型句。
% def は [ 名前 ][ 値 ] の順を期待するので exch で順序を合わせる。
% 引数はてっぺんが後ろの方なので、b から先に取り込む。

/gcd {
  /b exch def    % 2番目の引数を b に
  /a exch def    % 1番目の引数を a に

  { b 0 ne }     % b が 0 でない間くり返す
  {
    a b mod      % 余りを計算        [ a mod b ]
    /a b def     % a に b を入れる（この時点の b はまだ古い値）
    /b exch def  % b に余りを入れる
  } while

  a              % 答えは a に残っている
} def

12 18 gcd
